# Backend Environment Variables
# Copy this to .env for local development

# OpenAI API Key (required for Realtime mode and Chat API, optional for TTS if using Edge TTS)
OPENAI_API_KEY=your_openai_api_key_here

# Realtime API Model (default: gpt-realtime-mini)
REALTIME_MODEL=gpt-realtime-mini

# Chat Completion Model (default: gpt-4o-mini)
# Options: gpt-4o-mini, gpt-4o, gpt-3.5-turbo, etc.
CHAT_MODEL=gpt-4o-mini

# TTS Provider (default: gtts - most reliable free option)
# Options: 
#   - "gtts" (default): Free Google Text-to-Speech - most reliable, no API key needed
#   - "edge": Edge TTS (Microsoft, can be blocked/rate-limited)
#   - "openai": OpenAI TTS API (requires OPENAI_API_KEY, paid)
#   - "deepgram": Deepgram Aura-2 streaming TTS (requires DEEPGRAM_API_KEY, paid, low latency)
#   - "webspeech": Web Speech API (browser-native, handled client-side, no API key needed)
TTS_PROVIDER=gtts

# gTTS Language (only used when TTS_PROVIDER=gtts)
# Default: en (English)
# Options: en, en-us, en-gb, es, fr, de, it, pt, etc.
GTTS_LANG=en

# Edge TTS Voice (only used when TTS_PROVIDER=edge)
# Default: en-US-AriaNeural (warm, friendly voice suitable for children)
# Other options: en-US-JennyNeural, en-US-GuyNeural, en-GB-SoniaNeural, etc.
# List all voices: python -c "import asyncio; import edge_tts; asyncio.run(edge_tts.list_voices())"
EDGE_TTS_VOICE=en-US-AriaNeural

# STT Provider (default: webspeech - uses browser Web Speech API)
# Options:
#   - "webspeech" (default): Free browser Web Speech API - no API key needed
#   - "deepgramnova3": Deepgram Nova-3 streaming STT (requires DEEPGRAM_API_KEY, paid)
STT_PROVIDER=webspeech

# Deepgram API Key (required when STT_PROVIDER=deepgramnova3 or TTS_PROVIDER=deepgram)
# Get your API key from: https://console.deepgram.com/
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# Deepgram TTS Model (only used when TTS_PROVIDER=deepgram)
# Default: aura-2-thalia-en (warm, friendly voice suitable for children)
# Other options: aura-2-athena-en, aura-2-hera-en, aura-2-juno-en, aura-2-luna-en, etc.
# See: https://developers.deepgram.com/docs/aura-tts-models
DEEPGRAM_TTS_MODEL=aura-2-thalia-en

# Deepgram TTS Sample Rate (only used when TTS_PROVIDER=deepgram)
# Default: 48000 (48kHz - optimal for Aura-2)
# Options: 16000, 24000, 44100, 48000
DEEPGRAM_TTS_SAMPLE_RATE=48000

# Server Configuration
PORT=8000
ENV=development

# Frontend URL for CORS (optional, comma-separated for multiple URLs)
FRONTEND_URL=http://localhost:3000

