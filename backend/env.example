# Backend Environment Variables
# Copy this to .env for local development

# OpenAI API Key (required for Realtime mode and Chat API, optional for TTS if using Edge TTS)
OPENAI_API_KEY=your_openai_api_key_here

# Realtime API Model (default: gpt-realtime-mini)
REALTIME_MODEL=gpt-realtime-mini

# Chat Completion Model (default: gpt-4o-mini)
# Options: gpt-4o-mini, gpt-4o, gpt-3.5-turbo, etc.
CHAT_MODEL=gpt-4o-mini

# TTS Provider (default: gtts - most reliable free option)
# Options: 
#   - "gtts" (default): Free Google Text-to-Speech - most reliable, no API key needed
#   - "edge": Edge TTS (Microsoft, can be blocked/rate-limited)
#   - "openai": OpenAI TTS API (requires OPENAI_API_KEY, paid)
#   - "gcloudtts": Google Cloud TTS API (requires GOOGLE_APPLICATION_CREDENTIALS, uses free credits)
# Note: Frontend automatically fetches this value from /api/config endpoint on startup
# This serves as the single source of truth for TTS configuration
TTS_PROVIDER=gtts

# gTTS Language (only used when TTS_PROVIDER=gtts)
# Default: en (English)
# Options: en, en-us, en-gb, es, fr, de, it, pt, etc.
GTTS_LANG=en

# Edge TTS Voice (only used when TTS_PROVIDER=edge)
# Default: en-US-AriaNeural (warm, friendly voice suitable for children)
# Other options: en-US-JennyNeural, en-US-GuyNeural, en-GB-SoniaNeural, etc.
# List all voices: python -c "import asyncio; import edge_tts; asyncio.run(edge_tts.list_voices())"
EDGE_TTS_VOICE=en-US-AriaNeural

# Google Cloud TTS Voice (only used when TTS_PROVIDER=gcloudtts)
# Default: Standard voice - en-US-Standard-D ($4/1M chars), en-US-Neural2-D ($16/1M chars) (natural, friendly voice)
# Other options: en-US-Neural2-A, en-US-Neural2-B, en-US-Neural2-C, en-US-Neural2-E, en-US-Neural2-F, etc.
# List all voices: gcloud text-to-speech voices list
GCLOUD_TTS_VOICE=en-US-Standard-D

# Google Cloud TTS Language (only used when TTS_PROVIDER=gcloudtts)
# Default: en-US (English US)
# Options: en-US, en-GB, en-AU, es-ES, fr-FR, de-DE, etc.
GCLOUD_TTS_LANG=en-US

# STT Provider (default: webspeech - browser-based free option)
# Options:
#   - "webspeech" (default): Web Speech API (browser-based, free, no backend needed)
#   - "gpt-4o-mini-transcribe": GPT-4o-mini-transcribe using OpenAI Realtime API (requires OPENAI_API_KEY, paid, optimized for transcription)
#   - "gpt-4o-transcribe": GPT-4o-transcribe using OpenAI Realtime API (requires OPENAI_API_KEY, paid, higher quality)
#   - "gpt-realtime-mini": GPT Realtime Mini using OpenAI Realtime API (requires OPENAI_API_KEY, paid, cheaper option)
#   - Legacy options (still supported): "gpt4ominitranscribe", "gpt4otranscribe"
# Note: Frontend automatically fetches this value from /api/config endpoint on startup
# This serves as the single source of truth - no need to set NEXT_PUBLIC_STT_PROVIDER in frontend
# You only need to set STT_PROVIDER - the model is extracted from this value automatically
STT_PROVIDER=webspeech

# Google Cloud Credentials (required for gcloudtts and gcloudstt)
# Path to your Google Cloud service account JSON key file
# Example: GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json
# Or on Windows: GOOGLE_APPLICATION_CREDENTIALS=C:\path\to\service-account-key.json
# Get your service account key from: https://console.cloud.google.com/iam-admin/serviceaccounts
GOOGLE_APPLICATION_CREDENTIALS=

# Server Configuration
PORT=8000
ENV=development

# Frontend URL for CORS (optional, comma-separated for multiple URLs)
FRONTEND_URL=http://localhost:3000

