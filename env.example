# Frontend Environment Variables (Next.js)
# Copy this to .env.local for local development

# Backend API URL
# For local development, use: http://localhost:8000
# For production, set to your deployed backend URL
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# Mode Toggle
# Set to "OFF" to use Realtime API (better UX, more expensive)
# Set to "ON" to use STT/TTT/TTS mode (cost-effective, uses Web Speech API + GPT-4o-mini + TTS)
NEXT_PUBLIC_USE_STT_MODE=OFF

