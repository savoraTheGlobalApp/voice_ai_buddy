[Unit]
Description=Voice AI Buddy Update Daemon
Documentation=https://github.com/savoraTheGlobalApp/voice_ai_buddy
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# User and paths will be replaced by install_service.sh
User=REPLACE_USER
Group=REPLACE_USER
WorkingDirectory=REPLACE_HARDWARE_DIR
Environment="PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
Environment="GITHUB_REPO_URL=REPLACE_REPO_URL"
Environment="GITHUB_BRANCH=REPLACE_BRANCH"
Environment="GIT_SSH_COMMAND=REPLACE_GIT_SSH_COMMAND"
ExecStart=/usr/bin/python3 -m rpi_client.update_daemon
Restart=always
RestartSec=30
StandardOutput=journal
StandardError=journal
SyslogIdentifier=voice-ai-buddy-updater

# Resource limits
LimitNOFILE=65536

# Security settings
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target

