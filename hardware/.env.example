# RPi Client Environment Variables
# Copy this file to .env and fill in your values

# ============================================
# REQUIRED VARIABLES
# ============================================

# Backend API URL (your Railway backend URL or localhost for development)
# Example: https://your-backend.up.railway.app
# Or for local: http://localhost:8000
BACKEND_URL=https://your-backend.up.railway.app

# Firebase User ID (get this from your Firebase Auth)
# This identifies which user's memories and conversations to use
USER_UID=your_firebase_user_id_here

# User's name (for personalization)
USER_NAME=YourName

# ============================================
# OPTIONAL VARIABLES
# ============================================

# User's age (integer, for age-appropriate responses)
# USER_AGE=8

# Audio Configuration
# Leave unset to auto-detect devices
# AUDIO_INPUT_DEVICE=1
# AUDIO_OUTPUT_DEVICE=0

# Logging Level
# Options: DEBUG, INFO, WARNING, ERROR
# Default: INFO
# LOG_LEVEL=INFO