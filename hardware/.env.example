# Backend API Configuration
# URL of your Railway backend (or localhost for development)
# Example: https://your-app-name.railway.app
BACKEND_URL=http://localhost:8000

# Firebase Configuration
# Path to Firebase service account key JSON file
# Default: ../backend/service-account-key.json (relative to hardware/ folder)
# Make sure this file exists on your Raspberry Pi
FIREBASE_CREDENTIALS_PATH=../backend/service-account-key.json

# User Information (Required)
# Get USER_UID from Firebase Console -> Authentication -> Users
USER_UID=your_firebase_user_uid_here
USER_NAME=ChildName
USER_AGE=7

# Audio Configuration (Optional - auto-detected if not set)
# Run: python3 -c "from rpi_client.audio_handler import AudioHandler; ah = AudioHandler(); [print(f'{d[\"index\"]}: {d[\"name\"]}') for d in ah.list_devices()]"
# to find device indices
# AUDIO_INPUT_DEVICE=1   # Microphone device index
# AUDIO_OUTPUT_DEVICE=2  # Speaker device index
SAMPLE_RATE=16000        # Audio sample rate in Hz (16kHz recommended for STT)
CHUNK_SIZE=2048         # Audio buffer size in frames

# STT Configuration (default: googlecloud)
# Options: googlecloud, deepgram
# Note: googlecloud requires Google Cloud credentials configured on backend
STT_PROVIDER=googlecloud

# TTT Configuration (default: gpt-4o-mini)
# Chat model for text-to-text conversion
# Options: gpt-4o-mini, gpt-4o, gpt-3.5-turbo, etc.
CHAT_MODEL=gpt-4o-mini

# TTS Configuration (default: gtts)
# Options: 
#   - gtts: Free Google Text-to-Speech (default, most reliable)
#   - openai: OpenAI TTS API (requires OPENAI_API_KEY on backend, paid)
#   - edge: Edge TTS (Microsoft, free but can be rate-limited)
#   - deepgram: Deepgram Aura-2 streaming TTS (requires DEEPGRAM_API_KEY on backend, paid)
TTS_PROVIDER=gtts

# Memory Configuration
TOP_MEMORIES_COUNT=10   # Number of top memories to include in AI instructions
MEMORY_LIMIT=100        # Maximum number of memories per user

# Logging
# Options: DEBUG, INFO, WARNING, ERROR
# Use DEBUG for troubleshooting, INFO for normal operation
LOG_LEVEL=INFO

