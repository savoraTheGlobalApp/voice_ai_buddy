[Unit]
Description=Voice AI Buddy RPi Client
Documentation=https://github.com/savoraTheGlobalApp/voice_ai_buddy
After=network-online.target sound.target
Wants=network-online.target

[Service]
Type=simple
# User and paths will be replaced by install_service.sh
User=REPLACE_USER
Group=REPLACE_USER
WorkingDirectory=REPLACE_HARDWARE_DIR
# Use shared venv from /var/lib/voice_ai_buddy/venv (hybrid system)
Environment="PATH=/var/lib/voice_ai_buddy/venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
# Apply updates before starting (non-blocking, continues even if update fails)
# Use fixed orchestrator (never updated) - hybrid system
ExecStartPre=/usr/bin/python3 /opt/voice_ai_buddy_orchestrator/apply_update.py || true
# Use shared venv from /var/lib/voice_ai_buddy/venv
ExecStart=/var/lib/voice_ai_buddy/venv/bin/python -m rpi_client.main
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=voice-ai-buddy

# Resource limits
LimitNOFILE=65536

# Security settings
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target

