[Unit]
Description=Voice AI Buddy RPi Client
Documentation=https://github.com/yourusername/voice_ai_buddy
After=network-online.target sound.target
Wants=network-online.target

[Service]
Type=simple
# User and paths will be replaced by install_service.sh
User=REPLACE_USER
Group=REPLACE_USER
WorkingDirectory=REPLACE_HARDWARE_DIR
Environment="PATH=REPLACE_VENV_BIN:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
ExecStart=REPLACE_VENV_BIN/python -m rpi_client.main
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=voice-ai-buddy

# Resource limits
LimitNOFILE=65536

# Security settings
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target

